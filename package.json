{
  "name": "kevin-slack",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/huddle/SignalingProtocol.proto', 'dist/huddle/SignalingProtocol.proto')\"",
    "dev": "tsx watch src/index.ts",
    "import-slack-state": "node scripts/import-slack-state.mjs",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@slack/web-api": "^8.4.0",
    "dotenv": "^18.0.10",
    "libopus-wasm": "0.4.1",
    "node-datachannel": "0.33.6",
    "protobufjs": "8.8.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "axios": "^1.21.1",
    "follow-redirects": "^1.16.3"
  }
}
