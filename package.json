{
  "name": "kevin-slack",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/huddle/SignalingProtocol.proto', 'dist/huddle/SignalingProtocol.proto')\"",
    "dev": "tsx watch src/index.ts",
    "import-slack-state": "node scripts/import-slack-state.mjs",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@slack/web-api": "^7.0.0",
    "dotenv": "^17.0.0",
    "libopus-wasm": "0.4.1",
    "node-datachannel": "0.33.4",
    "protobufjs": "8.8.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
